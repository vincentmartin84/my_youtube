@startuml

class User {
  - lastName
  - firstName
  - email
  - password
  - roles
}

class Video {
  - title
  - file
  - createdAt
  - views
}

class VideoFormat {
  - format
  - file
}


class Role {
  - label 
}

create : User "0,*" -- "1" Video
have : Video "0,*" -- "1" VideoFormat
defined : user "1,*" -- "0,*" Role
@enduml