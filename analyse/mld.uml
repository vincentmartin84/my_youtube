@startUml

class User {
  - id primary key
  - firstName varchar
  - lastName varchar
  - createdAt datetime
}

class Video {
  - id primary key
  - title varchar
  - file varchar
  - user_id fk
}

class VideoFormat {
  - id primary key
  - format varchar
  - file varchar
  - video_id fk
}

class Role {
  - labell
}

class Role_User {
  user_id fk
  role_id fk
}


@enduml